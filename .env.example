# TikTok Auto DM Pro Configuration
HOST=0.0.0.0
PORT=8000

# Mode headless (true untuk server 24/7 tanpa monitor, false untuk melihat browser langsung)
HEADLESS=false

# Otomatis mulai bot saat aplikasi/server dinyalakan (tanpa harus klik tombol start manual)
AUTO_START=true

# Waktu interval pengecekan pesan inbox (detik)
CHECK_INTERVAL=12

# Delay pengetikan manusiawi (detik)
HUMAN_DELAY_MIN=1.5
HUMAN_DELAY_MAX=4.0

# Batas maksimal balasan per jam (anti spam protection)
MAX_DM_PER_HOUR=40

# Default cooldown balasan untuk user yang sama (detik, default 3600 = 1 jam)
DEFAULT_COOLDOWN=3600
